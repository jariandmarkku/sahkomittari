{
  "version": 2,
  "cleanUrls": false,
  "functions": {
    "api/**/*.js": {
      "includeFiles": "{templates/**/*.html,data/global_zones.json,data/dso_data.json,ml_weights.json}"
    }
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.spotpuls.app"
        }
      ],
      "destination": "https://spotpuls.app/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/ssr?country=fi"
    },
    {
      "source": "/index.html",
      "destination": "/api/ssr?country=fi"
    },
    {
      "source": "/:country(en|se|no|dk|ee|lv|lt|de|at|ch|nl|be|fr|gb|ie|es|pt|it|pl|cz|sk|hu|ro|bg|si|hr|gr)",
      "destination": "/api/ssr?country=:country"
    },
    {
      "source": "/:country(en|se|no|dk|ee|lv|lt|de|at|ch|nl|be|fr|gb|ie|es|pt|it|pl|cz|sk|hu|ro|bg|si|hr|gr)/",
      "destination": "/api/ssr?country=:country"
    },
    {
      "source": "/:country(en|se|no|dk|ee|lv|lt|de|at|ch|nl|be|fr|gb|ie|es|pt|it|pl|cz|sk|hu|ro|bg|si|hr|gr)/index.html",
      "destination": "/api/ssr?country=:country"
    },
    {
      "source": "/verkkoyhtiot/:slug((?!index$)[^/]+)\\.html",
      "destination": "/api/ssr?dso=:slug"
    },
    {
      "source": "/paikkakunnat/:slug((?!index$)[^/]+)\\.html",
      "destination": "/api/ssr?muni=:slug"
    },
    {
      "source": "/api/v1/zones",
      "destination": "/api/v1/prices?list=zones"
    },
    {
      "source": "/api/v1/ical/:zone.ics",
      "destination": "/api/v1/prices?zone=:zone&format=ical"
    },
    {
      "source": "/api/v1/shelly/:zone.json",
      "destination": "/api/v1/prices?zone=:zone&format=compact"
    },
    {
      "source": "/api/v1/ha/:zone.json",
      "destination": "/api/v1/prices?zone=:zone&format=ha"
    },
    {
      "source": "/api/v1/evcc/:zone.json",
      "destination": "/api/v1/prices?zone=:zone&format=evcc"
    },
    {
      "source": "/api/v1/victron/:zone.json",
      "destination": "/api/v1/prices?zone=:zone&format=victron"
    },
    {
      "source": "/api/v1/badge/:zone.svg",
      "destination": "/api/v1/prices?zone=:zone&format=badge"
    },
    {
      "source": "/api/v1/widget/:zone",
      "destination": "/api/v1/prices?zone=:zone&format=widget"
    },
    {
      "source": "/api/v1/plain/:zone",
      "destination": "/api/v1/prices?zone=:zone&format=plain"
    },
    {
      "source": "/api/v1/metrics",
      "destination": "/api/v1/prices?format=prometheus"
    },
    {
      "source": "/.well-known/llms.txt",
      "destination": "/llms.txt"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, OPTIONS"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=60, s-maxage=300, stale-while-revalidate=3600"
        },
        {
          "key": "X-Powered-By-Data",
          "value": "Spotpuls (https://spotpuls.app)"
        },
        {
          "key": "Link",
          "value": "<https://spotpuls.app/openapi.json>; rel=\"service-desc\", <https://spotpuls.app/llms.txt>; rel=\"describedby\""
        }
      ]
    },
    {
      "source": "/(openapi\\.json|llms\\.txt|llms-full\\.txt|\\.well-known/.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), camera=(), microphone=()"
        }
      ]
    }
  ]
}
